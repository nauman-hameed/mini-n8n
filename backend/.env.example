# Application
APP_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Admin protection
ADMIN_PIN=change-this-pin

# Credential encryption
CREDENTIAL_ENCRYPTION_KEY=replace-with-secure-key

# AI provider
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=gemma3:1b
GEMINI_API_KEY=

# Meta WhatsApp Cloud API
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=
META_APP_SECRET=
META_API_VERSION=v23.0

# Production AI (use Gemini on Railway — Ollama is local only)
AI_PROVIDER=gemini
GEMINI_API_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Google Sheets
GOOGLE_SPREADSHEET_ID=

# Authentication
JWT_SECRET_KEY=replace-with-long-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Local: leave unset to use SQLite at backend/storage/app.db
# Production (Railway): set to PostgreSQL URL from Railway plugin
DATABASE_URL=

# n8n → FastAPI integration (Railway + n8n credentials; never commit real values)
N8N_CALLBACK_SECRET=
N8N_INTERNAL_TOKEN=

# FastAPI → n8n SaaS WhatsApp forwarding (P2; leave URL empty until n8n HTTP webhook exists)
N8N_WHATSAPP_WEBHOOK_URL=
N8N_WHATSAPP_WEBHOOK_SECRET=

# Cookie settings (auto-configured on Railway when RAILWAY_PUBLIC_DOMAIN is set)
AUTH_COOKIE_SECURE=
AUTH_COOKIE_SAMESITE=